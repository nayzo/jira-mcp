# Jira MCP environment variables
# Copy to .env and fill in your values
# ⚠️ Never commit .env

# Jira Cloud connection
JIRA_HOST=your-company.atlassian.net
JIRA_USERNAME=your.email@company.com
JIRA_API_TOKEN=your_api_token

# Jira project
JIRA_PROJECT_KEY=ALM

# Optional field ID overrides. Otherwise, Jira MCP discovers fields by name.
JIRA_STORY_POINTS_FIELD=
JIRA_ACCEPTANCE_CRITERIA_FIELD=
JIRA_STORY_READINESS_FIELD=
JIRA_CRISIS_FIELD=
JIRA_SPRINT_FIELD=

# Optional select option IDs. Otherwise, resolve Yes/No in the issue context.
JIRA_STORY_READINESS_YES_ID=
JIRA_STORY_READINESS_NO_ID=
JIRA_CRISIS_YES_ID=
JIRA_CRISIS_NO_ID=

# Required only to use sprint names instead of sprint_id in create/update.
JIRA_SPRINT_BOARD_ID=

# Legacy project-specific fields (optional)
JIRA_EPIC_LINK_FIELD=customfield_10014
JIRA_PRODUCT_FIELD=
JIRA_PRODUCT_VALUE=
JIRA_PRODUCT_ID=
JIRA_CATEGORY_FIELD=
JIRA_DEFAULT_CATEGORY_ID=
JIRA_DEFAULT_CATEGORY_VALUE=
JIRA_ALTERNATE_CATEGORY_ID=
JIRA_ALTERNATE_CATEGORY_VALUE=
USE_ALTERNATE_CATEGORY=false

# Zephyr Squad Cloud test steps
ZAPI_BASE_URL=https://prod-api.zephyr4jiracloud.com/connect
ZAPI_ACCESS_KEY=
ZAPI_SECRET_KEY=
ZAPI_ACCOUNT_ID=

# Default assignee account ID, used when no assignee is passed to create-ticket
# Required on Jira projects where unassigned tickets are disabled
# Find your account ID with get-myself
JIRA_DEFAULT_ASSIGNEE_ACCOUNT_ID=

# Behaviour
AUTO_CREATE_TEST_TICKETS=true
